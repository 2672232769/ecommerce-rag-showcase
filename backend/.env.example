# ========== LLM 配置 ==========
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=768
# DeepSeek V4: disabled for ordinary short RAG answers; leave blank for other providers
LLM_THINKING=disabled

# ========== Embedding 配置 ==========
EMBEDDING_MODEL=BAAI/bge-m3 (ONNX INT8 dense)
# 可选：Embedding 与聊天使用不同服务时填写，空值复用聊天服务
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_PROVIDER=local_onnx
EMBEDDING_LOCAL_PATH=../models/bge-m3-onnx-int8
EMBEDDING_MAX_TOKENS=1024
EMBEDDING_THREADS=4

# ========== 安全配置 ==========
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ========== 管理员账号（首次启动自动创建） ==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ========== 数据库路径（默认值即可，无需修改） ==========
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads

# ========== 应用配置 ==========
DEBUG=false
